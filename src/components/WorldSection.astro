---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';

interface Props {
  section: CollectionEntry<'sections'>['data'];
  products: CollectionEntry<'products'>[];
  id: string;
  /** Link under the grid to the full range — the izlog is a taster, the shop has prices. */
  moreHref?: string;
  moreLabel?: string;
}
const { section, products, id, moreHref, moreLabel = 'Cijeli asortiman i cijene' } = Astro.props;
const sorted = [...products].sort((a, b) => a.data.order - b.data.order);
---

<section class="section wrap world" id={id} data-world={section.world}>
  <!-- data-speed <1 makes the heading block drift a touch slower than the
       cards below it as you scroll — a subtle depth cue. ScrollSmoother owns
       this (effects:true); it's a no-op under reduced motion (no smoother). -->
  <div class="world__head" data-speed="0.94">
    {section.num && <p class="world__num" data-reveal>{section.num}</p>}
    <h2 class="world__title" data-reveal>{section.title}</h2>
    {section.lead && <p class="world__lead" data-reveal>{section.lead}</p>}
  </div>

  <div class="world__grid" data-reveal-group>
    {sorted.map((p, i) => <ProductCard product={p.data} index={i} />)}
  </div>

  {
    moreHref && (
      <a class="world__more" href={moreHref} data-reveal>
        {moreLabel} <span aria-hidden="true">→</span>
      </a>
    )
  }

  {
    section.stats && section.stats.length > 0 && (
      <div class="world__stats" data-reveal-group>
        {section.stats.map((s) => (
          <div class="stat" data-reveal-item>
            <div class="stat__value">{s.value}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    )
  }
</section>

<style>
  .world__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .world__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .world__lead {
    max-width: 540px;
    margin-top: 18px;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    color: var(--muted);
  }

  .world__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 36px;
  }
  /* garden has 6, home 9 → 3-up desktop reads best for both */
  @media (max-width: 900px) {
    .world__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Phones: a swipeable shelf instead of a stack. Nine Dom cards one under the
     other were 6 000 px — seven screens — before the visitor reached the
     photos from real jobs. A shelf keeps every product one thumb away and the
     section under one screen tall; the next card peeking in at the edge is
     the cue that there is more to the right. ScrollSmoother is off on touch
     (motion.ts), so native horizontal scrolling is not hijacked. */
  @media (max-width: 640px) {
    .world__grid {
      display: flex;
      gap: 12px;
      margin-top: 28px;
      /* bleed past the .wrap inset so the shelf runs edge to edge */
      margin-inline: calc(-1 * clamp(20px, 5vw, 32px));
      padding-inline: clamp(20px, 5vw, 32px);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(20px, 5vw, 32px);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .world__grid::-webkit-scrollbar {
      display: none;
    }
    .world__grid > :global(*) {
      flex: 0 0 min(72vw, 300px);
      scroll-snap-align: start;
    }
  }

  .world__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-bottom: 3px;
    transition: border-color var(--dur-mid) var(--ease-out);
  }
  .world__more:hover {
    border-color: var(--accent);
  }
  .world__more span {
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .world__more:hover span {
    transform: translateX(3px);
  }

  .world__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 48px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--accent);
    line-height: 1;
  }
  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
  }
</style>
