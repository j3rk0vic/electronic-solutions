---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { resolveImage } from '../lib/images';

interface Props {
  product: CollectionEntry<'products'>['data'];
  index: number;
}

const { product, index } = Astro.props;
const img = resolveImage(product.image);
const idx = String(index + 1).padStart(2, '0');
const kicker = [idx, product.brand].filter(Boolean).join(' · ');
const alt = product.brand ? `${product.title} — ${product.brand}` : product.title;
---

<article class="card" data-reveal-item>
  <div class="card__frame">
    {product.badge && <span class="card__badge">{product.badge}</span>}
    {
      img ? (
        <div class="card__tile">
          <Image
            src={img}
            alt={alt}
            widths={[220, 320, 440]}
            sizes="(max-width:520px) 82vw, (max-width:900px) 44vw, 22vw"
            loading="lazy"
            layout="none"
            class="card__img"
          />
        </div>
      ) : (
        <div class="card__tile card__tile--empty" aria-hidden="true">
          <span class="card__mark">{product.title.charAt(0)}</span>
        </div>
      )
    }
  </div>
  <div class="card__body">
    <span class="card__kicker">{kicker}</span>
    <h3 class="card__title">{product.title}</h3>
    <p class="card__blurb">{product.blurb}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.7);
    transition:
      transform var(--dur-slow) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-8px);
    border-color: var(--accent);
    box-shadow: 0 26px 55px -28px color-mix(in srgb, var(--accent) 55%, black);
  }

  /* dark frame carrying a themed accent glow around the white product tile */
  .card__frame {
    position: relative;
    padding: 16px;
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      color-mix(in srgb, var(--surface) 88%, black);
  }

  /* consistent 4:5 surface; pure-white so transparent AND white-bg product
     shots read identically (seam-free) — uniform framed cards. */
  .card__tile {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #ffffff 0%, #ffffff 55%, #f1f1ee 100%);
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12% 14%;
    /* Contained zoom on hover — the tile clips (overflow:hidden) so nothing
       shifts. Reads as the product leaning toward the viewer. */
    transition: transform var(--dur-slow) var(--ease-out);
    will-change: transform;
  }
  .card:hover .card__img,
  .card:focus-within .card__img {
    transform: scale(1.06);
  }
  /* placeholder monogram gets the same subtle lean */
  .card__mark {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .card:hover .card__mark,
  .card:focus-within .card__mark {
    transform: scale(1.06);
  }

  /* graceful placeholder for imageless products (Solar, Servis) */
  .card__tile--empty {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--accent) 26%, var(--surface)), var(--surface) 72%);
  }
  .card__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 5rem);
    color: color-mix(in srgb, var(--accent) 80%, var(--text));
    opacity: 0.85;
    line-height: 1;
  }

  .card__badge {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 100px;
    color: var(--accent-ink);
    background: var(--accent);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 24px;
  }
  .card__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .card__blurb {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card__img,
    .card:hover .card__img,
    .card:focus-within .card__img,
    .card__mark,
    .card:hover .card__mark,
    .card:focus-within .card__mark {
      transition: none;
      transform: none;
    }
  }
</style>
