---
interface Props {
  blocks: { num: string; title: string; body: string; href?: string }[];
}
const { blocks } = Astro.props;
---

<div class="info" data-reveal-group>
  {
    blocks.map((b) => {
      const inner = (
        <>
          <span class="info__num">{b.num}</span>
          <h2 class="info__title">{b.title}</h2>
          <p class="info__body">{b.body}</p>
          {b.href && <span class="info__more">Pogledaj →</span>}
        </>
      );
      // A block with an href is a whole-card link; without one it stays plain
      // text, which is what /servis needs.
      return b.href ? (
        <a class="info__card info__card--link" href={b.href} data-reveal-item>
          {inner}
        </a>
      ) : (
        <article class="info__card" data-reveal-item>
          {inner}
        </article>
      );
    })
  }
</div>

<style>
  .info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 760px) {
    .info {
      grid-template-columns: 1fr;
    }
  }

  .info__card {
    padding: 32px 30px 34px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    transition:
      transform var(--dur-slow) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }
  .info__card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 26px 55px -30px color-mix(in srgb, var(--accent) 50%, black);
  }
  .info__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--accent);
  }
  .info__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-top: 16px;
  }
  .info__body {
    margin-top: 12px;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* Linked variant — used by the Usluge hub. */
  .info__card--link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .info__more {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    transition: translate var(--dur-mid) var(--ease-out);
  }
  .info__card--link:hover .info__more {
    translate: 4px 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .info__card:hover {
      transform: none;
    }
    .info__more,
    .info__card--link:hover .info__more {
      transition: none;
      translate: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info__card,
    .info__card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
