---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// Self-hosted fonts (were Google Fonts): no third-party round trip before the
// first paint, no fonts.gstatic request to disclose. Each package ships one
// woff2 per script with unicode-range, so a Croatian page pulls latin +
// latin-ext only. Bricolage comes with the optical-size axis — the display
// sizes need it or the headline letterforms run too loose.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/inter';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
// Preload the two faces the first screen is set in, so the headline and lead
// don't wait for the CSS to be parsed before the font request even starts.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { CollectionEntry } from 'astro:content';
import { real } from '../lib/placeholders';

interface Props {
  site: CollectionEntry<'settings'>['data'];
  /** 'morph' = the home page's green→red scroll morph. Otherwise a pinned palette. */
  theme?: 'morph' | 'vrt' | 'dom';
  /** Per-page overrides; falls back to the site-wide defaults in site.md. */
  seo?: { title: string; description: string };
}
const { site, theme = 'morph', seo: seoOverride } = Astro.props;
const seo = { ...site.seo, ...seoOverride };
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://electronic-solution.hr').href;

// Address-bar tint should match the palette the page actually opens with.
const themeColor = theme === 'dom' ? '#140807' : '#081310';

// LocalBusiness structured data — critical for local Metković search. Emitted
// on the home page only, so the business resolves to a single canonical entity.
// Only emit fields that have been filled in (skip [PLACEHOLDER]s) so the
// markup stays valid until the owner supplies real values.
const isHome = Astro.url.pathname === '/';

// Absolute URL to the social share card (public/og.png, generated by
// scripts/gen-og.mjs). Absolute is required — scrapers don't resolve relatives.
const ogImage = new URL('/og.png', Astro.site ?? 'https://electronic-solution.hr').href;

// The owner keeps one human address line; schema.org wants it in parts.
// "Splitska ul. 48, 20350 Metković" → street / postcode / town. If it is ever
// written in another shape, fall back to sending the whole line as the street
// rather than emitting wrong parts.
const addr = real(site.address);
const parts = addr?.match(/^(.*?),\s*(\d{5})\s+(.+)$/);
const addressLd = {
  '@type': 'PostalAddress',
  addressCountry: 'HR',
  streetAddress: parts?.[1] ?? addr,
  postalCode: parts?.[2],
  addressLocality: parts?.[3] ?? 'Metković',
};

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Store'],
  name: site.company,
  description: site.seo.description,
  url: new URL('/', Astro.site ?? 'https://electronic-solution.hr').href,
  image: ogImage,
  logo: ogImage,
  priceRange: '€€',
  areaServed: site.region,
  address: addressLd,
  telephone: real(site.phoneHref),
  email: real(site.email),
  // Only the machine format is valid here — the prose in `hours` is for humans.
  openingHours: real(site.hoursSchema) || undefined,
  brand: site.brands,
};
---

<!doctype html>
<html lang="hr" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content={themeColor} />

    <!-- Smooth in-place navigation between pages (home ⇄ trgovina/servis/o-nama).
         motion.ts rebuilds ScrollSmoother on astro:page-load and tears it down
         on astro:before-swap. Falls back to a normal load where unsupported. -->
    <ClientRouter />
    <!-- Cross-page pinned palette flash guard: pinned pages set their theme-color
         and data-theme in the merged head, so the swap keeps the right palette. -->

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:site_name" content={site.company} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>

  <body>
    <a href="#top" class="skip-link">Preskoči na sadržaj</a>

    <!-- ambient floating orbs (fixed, behind everything) -->
    <div class="orb orb--1" data-speed="0.85" aria-hidden="true"></div>
    <div class="orb orb--2" data-speed="1.1" aria-hidden="true"></div>
    <div class="orb orb--3" data-speed="0.7" aria-hidden="true"></div>

    <slot name="nav" />

    <!-- ScrollSmoother scaffolding -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main>
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/motion';
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 100;
        transform: translateY(-150%);
        padding: 10px 16px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        transition: transform 0.2s ease;
      }
      .skip-link:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
