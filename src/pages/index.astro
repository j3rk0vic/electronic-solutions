---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorldSection from '../components/WorldSection.astro';
import WorkGallery from '../components/WorkGallery.astro';
import ValueStrip from '../components/ValueStrip.astro';
import Contact from '../components/Contact.astro';

// ── load editable content ────────────────────────────────────────────
const site = (await getEntry('settings', 'site'))!.data;

const sectionEntries = await getCollection('sections');
const section = (id: string) => sectionEntries.find((s) => s.id === id)!.data;

const works = await getCollection('works');

const products = await getCollection('products');
const byWorld = (world: 'vrt' | 'dom') => products.filter((p) => p.data.world === world);

const gardenProducts = byWorld('vrt');
// Televisions live in Dom too — the page morphs green→red across two worlds,
// and the nav toggle only ever knew Vrt⇄Dom, so a third strip sat outside both.
const homeProducts = byWorld('dom');
---

<Layout site={site} theme="morph">
  <Nav slot="nav" site={site} home current="/" />

  <Hero hero={section('hero')} brands={site.brands} />

  <WorldSection id="vrt" section={section('vrt')} products={gardenProducts} />

  <WorldSection id="dom" section={section('dom')} products={homeProducts} />

  <WorkGallery section={section('radovi')} works={works} />

  <ValueStrip value={section('value')} region={site.region} />

  <Contact contact={section('contact')} site={site} />
</Layout>
