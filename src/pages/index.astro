---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorldSection from '../components/WorldSection.astro';
import WorkGallery from '../components/WorkGallery.astro';
import ValueStrip from '../components/ValueStrip.astro';
import Contact from '../components/Contact.astro';

// ── load editable content ────────────────────────────────────────────
const site = (await getEntry('settings', 'site'))!.data;

const sectionEntries = await getCollection('sections');
const section = (id: string) => sectionEntries.find((s) => s.id === id)!.data;

/**
 * A taster, not the whole set — the full gallery lives on /usluge. Only the
 * photos flagged `featured` in src/content/works, so the home page shows three
 * different jobs rather than the first five files (which were one floor,
 * four times over). Falls back to the first five if nothing is flagged.
 */
const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const featured = allWorks.filter((w) => w.data.featured);
const works = featured.length ? featured : allWorks.slice(0, 5);

const products = await getCollection('products');
const byWorld = (world: 'vrt' | 'dom') => products.filter((p) => p.data.world === world);

const gardenProducts = byWorld('vrt');
// Televisions live in Dom too — the page morphs green→red across two worlds,
// and the nav toggle only ever knew Vrt⇄Dom, so a third strip sat outside both.
const homeProducts = byWorld('dom');
---

<Layout site={site} theme="morph">
  <Nav slot="nav" site={site} home current="/" />

  <Hero hero={section('hero')} brands={site.brands} />

  <WorldSection id="vrt" section={section('vrt')} products={gardenProducts} moreHref="/trgovina" />

  <WorldSection id="dom" section={section('dom')} products={homeProducts} moreHref="/trgovina" />

  <WorkGallery
    section={section('radovi')}
    works={works}
    ctaHref="/usluge"
    ctaLabel="Pogledajte usluge"
  />

  <ValueStrip value={section('value')} region={site.region} />

  <Contact contact={section('contact')} site={site} />
</Layout>
