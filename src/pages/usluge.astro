---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import InfoGrid from '../components/InfoGrid.astro';
import WorkGallery from '../components/WorkGallery.astro';
import Contact from '../components/Contact.astro';

const site = (await getEntry('settings', 'site'))!.data;
const page = (await getEntry('pages', 'usluge'))!.data;
const contact = (await getCollection('sections')).find((s) => s.id === 'contact')!.data;

/**
 * The full set lives here — this is the page where someone deciding whether to
 * call wants to see everything we have actually done. The home page shows a
 * taster that points here; each service page shows only its own jobs.
 * All eight fill the 6-column mosaic exactly: wide(6), 2+2+2, 2+2+2, 2+4.
 */
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const gallerySection = {
  order: 0,
  world: 'dom' as const,
  num: '',
  eyebrow: 'Naši radovi',
  title: 'Ovako to izgleda uživo.',
  lead: 'Slike s naših gradilišta — polaganje podnog grijanja i strojarnice s Viessmann dizalicama topline. Sve smo radili sami. Kliknite na sliku za veći prikaz.',
  // The steps already appear above as page stats; don't repeat them here.
  stats: [],
};
---

<Layout site={site} theme={page.theme} seo={page.seo}>
  <Nav slot="nav" site={site} current="/usluge" />

  <PageHeader page={page} />

  <section class="section wrap usluge">
    <InfoGrid blocks={page.blocks} />

    {
      page.stats.length > 0 && (
        <div class="page-stats" data-reveal-group>
          {page.stats.map((s) => (
            <div data-reveal-item>
              <div class="page-stats__value">{s.value}</div>
              <div class="page-stats__label">{s.label}</div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <WorkGallery section={gallerySection} works={works} />

  <Contact contact={contact} site={site} />
</Layout>

<style>
  .usluge {
    padding-top: clamp(24px, 4vw, 40px);
  }
  .page-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 48px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .page-stats__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.02em;
    color: var(--accent);
    line-height: 1;
  }
  .page-stats__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
  }
</style>
